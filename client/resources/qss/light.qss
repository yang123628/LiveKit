QWidget {
    background-color: #ffffff;
    color: #333333;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #ffffff;
}

#authPage {
    background-color: #f5f5f5;
}

#authContainer {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e8e8e8;
}

QLabel#authLogo {
    color: #e94560;
    font-size: 36px;
    font-weight: bold;
}

QLabel#authSubtitle {
    color: #999999;
    font-size: 14px;
}

QLineEdit#authInput {
    background-color: #f8f8f8;
    color: #333333;
    border: 2px solid #e8e8e8;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}

QLineEdit#authInput:focus {
    border: 2px solid #4a90d9;
}

QLineEdit#authInput::placeholder {
    color: #b0b0b0;
}

QPushButton#authButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4a90d9, stop:1 #357abd);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#authButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5aa0e9, stop:1 #4a90d9);
}

QPushButton#authButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #357abd, stop:1 #2a6aad);
}

QPushButton#authButton:disabled {
    background-color: #d0d0d0;
    color: #999999;
}

QLabel#authError {
    color: #e94560;
    font-size: 13px;
}

QLabel#authLoading {
    color: #999999;
    font-size: 13px;
}

QLabel#authSwitchText {
    color: #999999;
    font-size: 13px;
}

QPushButton#authSwitchButton {
    background-color: transparent;
    color: #4a90d9;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 0;
}

QPushButton#authSwitchButton:hover {
    color: #5aa0e9;
}

QLabel#authAvatarTitle {
    color: #666666;
    font-size: 13px;
}

#avatarGrid {
    background-color: transparent;
}

QPushButton#avatarButton {
    background-color: #f0f0f0;
    border: 3px solid transparent;
    border-radius: 12px;
    padding: 4px;
}

QPushButton#avatarButton:hover {
    border: 3px solid #4a90d9;
}

QPushButton#avatarButton:checked {
    border: 3px solid #e94560;
}

#navigationBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QPushButton#navButton {
    background-color: transparent;
    color: #999999;
    border: none;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 0;
    min-height: 36px;
}

QPushButton#navButton:hover {
    color: #e94560;
}

QPushButton#navButton:checked {
    color: #e94560;
    border-bottom: 3px solid #e94560;
}

#pageLiveHall, #pageStartLive, #pageProfile, #pageAnchorRoom, #pageLiveRoom {
    background-color: #ffffff;
}

#hallHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e8e8e8;
}

QLabel#hallLogo {
    color: #e94560;
    font-size: 22px;
    font-weight: bold;
}

#hallCategoryBar {
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
}

QPushButton#categoryButton {
    background-color: transparent;
    color: #999999;
    border: 2px solid transparent;
    border-radius: 16px;
    padding: 4px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#categoryButton:hover {
    color: #333333;
    border: 2px solid #e0e0e0;
}

QPushButton#categoryButton:checked {
    background-color: #4a90d9;
    color: #ffffff;
    border: 2px solid #4a90d9;
}

#hallScrollArea {
    background-color: #f8f8f8;
    border: none;
}

#hallScrollContent {
    background-color: #f8f8f8;
}

QLabel#hallEmptyLabel {
    color: #b0b0b0;
    font-size: 18px;
}

#roomCard {
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 12px;
}

#roomCover {
    background-color: #e0e0e0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel#roomCategory {
    background-color: rgba(74, 144, 217, 200);
    color: #ffffff;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: bold;
}

#roomInfoBar {
    background-color: #ffffff;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QLabel#roomAvatar {
    border: 2px solid #e0e0e0;
    border-radius: 18px;
}

QLabel#roomTitle {
    color: #333333;
    font-size: 13px;
    font-weight: bold;
}

QLabel#roomAnchorName {
    color: #999999;
    font-size: 11px;
}

QLabel#roomViewerCount {
    color: #999999;
    font-size: 11px;
}

QLabel#pageTitle {
    color: #333333;
    font-size: 28px;
    font-weight: bold;
}

QLabel {
    color: #333333;
}

QPushButton {
    background-color: #4a90d9;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #5aa0e9;
}

QPushButton:pressed {
    background-color: #3a80c9;
}

QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #4a90d9;
}

QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QLabel#formLabel {
    color: #666666;
    font-size: 14px;
    font-weight: bold;
}

QLineEdit#liveInput {
    background-color: #f8f8f8;
    color: #333333;
    border: 2px solid #e8e8e8;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}

QLineEdit#liveInput:focus {
    border: 2px solid #4a90d9;
}

QLineEdit#liveInput::placeholder {
    color: #b0b0b0;
}

QComboBox#liveCombo {
    background-color: #f8f8f8;
    color: #333333;
    border: 2px solid #e8e8e8;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}

QComboBox#liveCombo::drop-down {
    border: none;
}

QComboBox#liveCombo QAbstractItemView {
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

QRadioButton#liveRadio {
    color: #333333;
    font-size: 14px;
    spacing: 8px;
}

QRadioButton#liveRadio::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #d0d0d0;
    background-color: #ffffff;
}

QRadioButton#liveRadio::indicator:checked {
    background-color: #4a90d9;
    border: 2px solid #4a90d9;
}

QPushButton#startLiveButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4a90d9, stop:1 #357abd);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#startLiveButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5aa0e9, stop:1 #4a90d9);
}

QPushButton#startLiveButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #357abd, stop:1 #2a6aad);
}

#anchorPreview {
    background-color: #000000;
    border: none;
}

#anchorControlBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QLabel#viewerCountLabel {
    color: #e94560;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#stopLiveButton {
    background-color: #e94560;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#stopLiveButton:hover {
    background-color: #ff5a70;
}

QPushButton#stopLiveButton:pressed {
    background-color: #c73a54;
}

#liveVideoWidget {
    background-color: #000000;
    border: none;
}

#liveControlBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QPushButton#backButton {
    background-color: transparent;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QPushButton#backButton:hover {
    background-color: #f0f0f0;
}

QLabel#volumeLabel {
    color: #999999;
    font-size: 13px;
}

QSlider#volumeSlider::groove:horizontal {
    background-color: #e0e0e0;
    height: 4px;
    border-radius: 2px;
}

QSlider#volumeSlider::handle:horizontal {
    background-color: #4a90d9;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider#volumeSlider::sub-page:horizontal {
    background-color: #4a90d9;
    border-radius: 2px;
}

QPushButton#fullscreenButton {
    background-color: transparent;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
}

QPushButton#fullscreenButton:hover {
    background-color: #f0f0f0;
}

#danmakuInputBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QLineEdit#danmakuInput {
    background-color: #ffffff;
    color: #333333;
    border: 2px solid #e0e0e0;
    border-radius: 16px;
    padding: 6px 14px;
    font-size: 13px;
}

QLineEdit#danmakuInput:focus {
    border: 2px solid #4a90d9;
}

QLineEdit#danmakuInput::placeholder {
    color: #b0b0b0;
}

QPushButton#danmakuSendButton {
    background-color: #4a90d9;
    color: #ffffff;
    border: none;
    border-radius: 16px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#danmakuSendButton:hover {
    background-color: #5aa0e9;
}

QPushButton#danmakuSendButton:pressed {
    background-color: #3a80c9;
}

#anchorDanmakuPanel {
    background-color: #f5f5f5;
    border-left: 1px solid #e0e0e0;
}

QLabel#danmakuTitle {
    color: #333333;
    font-size: 15px;
    font-weight: bold;
    background-color: #e8e8e8;
}

#danmakuOverlay {
    background: transparent;
}

#anchorDanmaku {
    background: transparent;
}

#giftPanelContent {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
}

QPushButton#giftButton {
    background-color: #f0f0f0;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    padding: 4px;
}

QPushButton#giftButton:hover {
    background-color: #e0e0e0;
    border: 2px solid #4a90d9;
}

QPushButton#giftButton:pressed {
    background-color: #d0d0d0;
}

QLabel#giftNameLabel {
    color: #666666;
    font-size: 11px;
    background: transparent;
}

QPushButton#giftOpenButton {
    background-color: #f0f0f0;
    color: #333333;
    border: none;
    border-radius: 16px;
    padding: 6px 12px;
    font-size: 16px;
}

QPushButton#giftOpenButton:hover {
    background-color: #e0e0e0;
}

QPushButton#giftOpenButton:pressed {
    background-color: #d0d0d0;
}

QPushButton#likeButton {
    background-color: rgba(233, 69, 96, 30);
    color: #e94560;
    border: 2px solid #e94560;
    border-radius: 22px;
    font-size: 22px;
    padding: 0px;
}

QPushButton#likeButton:hover {
    background-color: rgba(233, 69, 96, 60);
}

QPushButton#likeButton:pressed {
    background-color: rgba(233, 69, 96, 100);
}

QLabel#likeCountLabel {
    color: #e94560;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QLabel#giftAnimText {
    color: #333333;
    font-size: 13px;
    background: transparent;
}

#rightOverlay {
    background: transparent;
}

#floatingHearts {
    background: transparent;
}

#hallModeBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}

QPushButton#modeTabButton {
    background-color: transparent;
    color: #999999;
    border: 2px solid transparent;
    border-radius: 14px;
    padding: 2px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#modeTabButton:hover {
    color: #333333;
    border: 2px solid #e0e0e0;
}

QPushButton#modeTabButton:checked {
    background-color: #4a90d9;
    color: #ffffff;
    border: 2px solid #4a90d9;
}

QLabel#replayDurationLabel {
    background-color: rgba(0, 0, 0, 180);
    color: #ffffff;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}

#replayVideoWidget {
    background-color: #000000;
    border: none;
}

#replayControlBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QSlider#replayProgressSlider::groove:horizontal {
    background-color: #e0e0e0;
    height: 4px;
    border-radius: 2px;
}

QSlider#replayProgressSlider::handle:horizontal {
    background-color: #4a90d9;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider#replayProgressSlider::sub-page:horizontal {
    background-color: #4a90d9;
    border-radius: 2px;
}

QPushButton#playPauseButton {
    background-color: #4a90d9;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#playPauseButton:hover {
    background-color: #5aa0e9;
}

QPushButton#playPauseButton:pressed {
    background-color: #3a80c9;
}

QLabel#replayTimeLabel {
    color: #999999;
    font-size: 13px;
}
