QWidget {
    background-color: #ffffff;
    color: #333333;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #ffffff;
}

#authPage {
    background-color: #f5f5f5;
}

#authContainer {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e8e8e8;
}

QLabel#authLogo {
    color: #e94560;
    font-size: 36px;
    font-weight: bold;
}

QLabel#authSubtitle {
    color: #999999;
    font-size: 14px;
}

QLineEdit#authInput {
    background-color: #f8f8f8;
    color: #333333;
    border: 2px solid #e8e8e8;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}

QLineEdit#authInput:focus {
    border: 2px solid #4a90d9;
}

QLineEdit#authInput::placeholder {
    color: #b0b0b0;
}

QPushButton#authButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4a90d9, stop:1 #357abd);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#authButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5aa0e9, stop:1 #4a90d9);
}

QPushButton#authButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #357abd, stop:1 #2a6aad);
}

QPushButton#authButton:disabled {
    background-color: #d0d0d0;
    color: #999999;
}

QLabel#authError {
    color: #e94560;
    font-size: 13px;
}

QLabel#authLoading {
    color: #999999;
    font-size: 13px;
}

QLabel#authSwitchText {
    color: #999999;
    font-size: 13px;
}

QPushButton#authSwitchButton {
    background-color: transparent;
    color: #4a90d9;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 0;
}

QPushButton#authSwitchButton:hover {
    color: #5aa0e9;
}

QLabel#authAvatarTitle {
    color: #666666;
    font-size: 13px;
}

#avatarGrid {
    background-color: transparent;
}

QPushButton#avatarButton {
    background-color: #f0f0f0;
    border: 3px solid transparent;
    border-radius: 12px;
    padding: 4px;
}

QPushButton#avatarButton:hover {
    border: 3px solid #4a90d9;
}

QPushButton#avatarButton:checked {
    border: 3px solid #e94560;
}

#navigationBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QPushButton#navButton {
    background-color: transparent;
    color: #999999;
    border: none;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 0;
    min-height: 36px;
}

QPushButton#navButton:hover {
    color: #e94560;
}

QPushButton#navButton:checked {
    color: #e94560;
    border-bottom: 3px solid #e94560;
}

#pageLiveHall, #pageStartLive, #pageProfile {
    background-color: #ffffff;
}

QLabel#pageTitle {
    color: #333333;
    font-size: 28px;
    font-weight: bold;
}

QLabel {
    color: #333333;
}

QPushButton {
    background-color: #4a90d9;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #5aa0e9;
}

QPushButton:pressed {
    background-color: #3a80c9;
}

QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #4a90d9;
}

QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #4a90d9;
    selection-color: #ffffff;
}

QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
