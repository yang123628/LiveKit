QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #1a1a2e;
}

#authPage {
    background-color: #1a1a2e;
}

#authContainer {
    background-color: #16213e;
    border-radius: 16px;
}

QLabel#authLogo {
    color: #e94560;
    font-size: 36px;
    font-weight: bold;
}

QLabel#authSubtitle {
    color: #a0a0a0;
    font-size: 14px;
}

QLineEdit#authInput {
    background-color: #0f3460;
    color: #e0e0e0;
    border: 2px solid #0f3460;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}

QLineEdit#authInput:focus {
    border: 2px solid #e94560;
}

QLineEdit#authInput::placeholder {
    color: #607090;
}

QPushButton#authButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e94560, stop:1 #c73a54);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#authButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff5a70, stop:1 #e94560);
}

QPushButton#authButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #c73a54, stop:1 #a82e44);
}

QPushButton#authButton:disabled {
    background-color: #3a2040;
    color: #606060;
}

QLabel#authError {
    color: #e94560;
    font-size: 13px;
}

QLabel#authLoading {
    color: #a0a0a0;
    font-size: 13px;
}

QLabel#authSwitchText {
    color: #808080;
    font-size: 13px;
}

QPushButton#authSwitchButton {
    background-color: transparent;
    color: #e94560;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 0;
}

QPushButton#authSwitchButton:hover {
    color: #ff5a70;
}

QLabel#authAvatarTitle {
    color: #c0c0c0;
    font-size: 13px;
}

#avatarGrid {
    background-color: transparent;
}

QPushButton#avatarButton {
    background-color: #0f3460;
    border: 3px solid transparent;
    border-radius: 12px;
    padding: 4px;
}

QPushButton#avatarButton:hover {
    border: 3px solid #4a90d9;
}

QPushButton#avatarButton:checked {
    border: 3px solid #e94560;
}

#navigationBar {
    background-color: #16213e;
    border-top: 1px solid #0f3460;
}

QPushButton#navButton {
    background-color: transparent;
    color: #a0a0a0;
    border: none;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 0;
    min-height: 36px;
}

QPushButton#navButton:hover {
    color: #e94560;
}

QPushButton#navButton:checked {
    color: #e94560;
    border-bottom: 3px solid #e94560;
}

#pageLiveHall, #pageStartLive, #pageProfile {
    background-color: #1a1a2e;
}

#hallHeader {
    background-color: #16213e;
}

QLabel#hallLogo {
    color: #e94560;
    font-size: 22px;
    font-weight: bold;
}

#hallCategoryBar {
    background-color: #16213e;
}

QPushButton#categoryButton {
    background-color: transparent;
    color: #a0a0a0;
    border: 2px solid transparent;
    border-radius: 16px;
    padding: 4px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#categoryButton:hover {
    color: #e0e0e0;
    border: 2px solid #0f3460;
}

QPushButton#categoryButton:checked {
    background-color: #e94560;
    color: #ffffff;
    border: 2px solid #e94560;
}

#hallScrollArea {
    background-color: #1a1a2e;
    border: none;
}

#hallScrollContent {
    background-color: #1a1a2e;
}

QLabel#hallEmptyLabel {
    color: #607090;
    font-size: 18px;
}

#roomCard {
    background-color: #16213e;
    border-radius: 12px;
}

#roomCover {
    background-color: #0f3460;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel#roomCategory {
    background-color: rgba(233, 69, 96, 200);
    color: #ffffff;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: bold;
}

#roomInfoBar {
    background-color: #16213e;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QLabel#roomAvatar {
    border: 2px solid #0f3460;
    border-radius: 18px;
}

QLabel#roomTitle {
    color: #e0e0e0;
    font-size: 13px;
    font-weight: bold;
}

QLabel#roomAnchorName {
    color: #808080;
    font-size: 11px;
}

QLabel#roomViewerCount {
    color: #808080;
    font-size: 11px;
}

QLabel#pageTitle {
    color: #e0e0e0;
    font-size: 28px;
    font-weight: bold;
}

QLabel {
    color: #e0e0e0;
}

QPushButton {
    background-color: #0f3460;
    color: #e0e0e0;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #1a4a8a;
}

QPushButton:pressed {
    background-color: #0a2540;
}

QLineEdit {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #e94560;
}

QComboBox {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 8px 12px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    color: #e0e0e0;
    selection-background-color: #0f3460;
}

QScrollBar:vertical {
    background-color: #1a1a2e;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #0f3460;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1a1a2e;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #0f3460;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
