QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #1a1a2e;
}

#navigationBar {
    background-color: #16213e;
    border-top: 1px solid #0f3460;
}

QPushButton#navButton {
    background-color: transparent;
    color: #a0a0a0;
    border: none;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 0;
    min-height: 36px;
}

QPushButton#navButton:hover {
    color: #e94560;
}

QPushButton#navButton:checked {
    color: #e94560;
    border-bottom: 3px solid #e94560;
}

#pageLiveHall, #pageStartLive, #pageProfile {
    background-color: #1a1a2e;
}

QLabel#pageTitle {
    color: #e0e0e0;
    font-size: 28px;
    font-weight: bold;
}

QLabel {
    color: #e0e0e0;
}

QPushButton {
    background-color: #0f3460;
    color: #e0e0e0;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #1a4a8a;
}

QPushButton:pressed {
    background-color: #0a2540;
}

QLineEdit {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #e94560;
}

QComboBox {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 8px 12px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    color: #e0e0e0;
    selection-background-color: #0f3460;
}

QScrollBar:vertical {
    background-color: #1a1a2e;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #0f3460;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1a1a2e;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #0f3460;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
